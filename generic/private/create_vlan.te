type vendor_create_vlan, domain;
type vendor_create_vlan_exec, system_file_type, exec_type, file_type;

typeattribute vendor_create_vlan coredomain;

init_daemon_domain(vendor_create_vlan)

userdebug_or_eng(`
allow vendor_create_vlan kmsg_device:chr_file { write open };
allow vendor_create_vlan kmsg_debug_device:chr_file { write ioctl };
')

allow vendor_create_vlan system_file:file { execute_no_trans lock };
allow vendor_create_vlan vendor_create_vlan:netlink_route_socket { bind write getattr create setopt read nlmsg_write nlmsg_readpriv nlmsg_read };
allow vendor_create_vlan vendor_create_vlan:udp_socket { create ioctl bind connect write getattr setattr };
allowxperm vendor_create_vlan vendor_create_vlan:udp_socket ioctl { SIOCGIFINDEX };
allow vendor_create_vlan vendor_create_vlan:capability { net_admin net_raw };
allow vendor_create_vlan proc_net:file { write open read getattr };
allow vendor_create_vlan net_data_file:dir { search };
allow vendor_create_vlan shell_exec:file { map read execute getattr };
allow vendor_create_vlan toolbox_exec:file { getattr execute read open execute_no_trans map };
allow vendor_create_vlan net_data_file:file { getattr read open };
allow vendor_create_vlan port:udp_socket { name_bind };
allow vendor_create_vlan node:udp_socket { node_bind };
allow vendor_create_vlan vendor_create_vlan:rawip_socket { create getopt setopt };

