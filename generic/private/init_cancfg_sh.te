type init_cancfg_sh, domain, coredomain;
type init_cancfg_sh_exec, exec_type, system_file_type, file_type;
init_daemon_domain(init_cancfg_sh);

allow init_cancfg_sh rootfs:dir { open read };
allow init_cancfg_sh self:capability net_admin;
allow init_cancfg_sh self:netlink_route_socket { bind create getattr nlmsg_readpriv nlmsg_write read setopt write };
allow init_cancfg_sh self:udp_socket { create ioctl };
allow init_cancfg_sh shell_exec:file { execute getattr map read };
allow init_cancfg_sh system_file:file execute_no_trans;
allow init_cancfg_sh toolbox_exec:file { execute execute_no_trans getattr map open read };
allow init_cancfg_sh self:global_capability_class_set { net_admin net_raw };
