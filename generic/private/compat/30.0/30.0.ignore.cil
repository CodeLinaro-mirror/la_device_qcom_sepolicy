;; new_objects - a collection of types that have been introduced that have no
;;   analogue in older policy.  Thus, we do not need to map these types to
;;   previous ones.  Add here to pass checkapi test
(type new_objects)
(typeattribute new_objects)
(typeattributeset new_objects
  ( new_objects
    vendor_hal_displayconfig_service
    vendor_hal_telephony_service
    vendor_mm_parser_prop
    vendor_persist_tcm_prop
    vendor_persist_rcs_prop
    vendor_qvirtmgr
    vendor_qesdk_service
    vendor_qcc_authmgr_app
    vendor_qcc_netstat_app
    vendor_smcinvoke_device
    evs_ais_app
    procfsinspector_service
    sysfs_fs_lifetime_write
    mesh_missing_vms_prop
    open_dice_device
    sdv_dice_chain_provider_service
    sdv_dt_service
    sdv_ethernet_ready_prop
    sdv_id_service
    sdv_mesh_provisioning_service
    sdv_mesh_status_service
    sdv_privileged_gatewaynetworking_service
    sdv_rpcagent_service
    sdv_sd_service
    sdv_transport_support_service
    vsock_device
    vendor_qcc_lmtp_app))
