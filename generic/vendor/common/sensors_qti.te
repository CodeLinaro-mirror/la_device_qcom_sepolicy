# Policy for sensor daemon
type sensors_qti, domain;
type sensors_qti_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(sensors_qti)
get_prop(sensors_qti, sensors_prop)

allow sensors_qti self:capability {
    setuid
    setgid
    net_bind_service
};

# Access to tests from userdebug/eng builds
userdebug_or_eng(`
  diag_use(sensors_qti)
  get_prop(sensors_qti, sensors_dbg_prop)

  #allow starting of diag_mdlog
  allow sensors_qti qlogd_exec:file rx_file_perms;
  allow sensors_qti vendor_shell_exec:file rx_file_perms;
')

allow sensors_qti self:{ socket qipcrtr_socket } create_socket_perms;
# ioctlcmd=c304
allowxperm sensors_qti self:{ socket qipcrtr_socket } ioctl msm_sock_ipc_ioctls;

allow sensors_qti mnt_vendor_file:dir r_dir_perms;

allow sensors_qti sensors_vendor_data_file:dir create_dir_perms;
allow sensors_qti sensors_vendor_data_file:file create_file_perms;

allow sensors_qti persist_sensors_file:fifo_file create_file_perms;
# Access to /persist/sensors
allow sensors_qti persist_sensors_file:dir create_dir_perms;
allow sensors_qti persist_sensors_file:file create_file_perms;
# Access to wakelock sysfs
wakelock_use(sensors_qti)
