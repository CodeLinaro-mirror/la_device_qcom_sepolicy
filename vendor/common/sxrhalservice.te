#Define Domain
type sxrhalservice_qti, domain;
type sxrhalservice_qti_exec, exec_type, vendor_file_type, file_type;

hal_server_domain(sxrhalservice_qti,sxrhalservice)

#Allow for transition from init domain to sxrhalservice
init_daemon_domain(sxrhalservice_qti)

#Allow sxrhalservice to use Vendor Binder IPC
vndbinder_use(sxrhalservice)

# Allow hwbinder call from hal client to server
binder_call(sxrhalservice_client, sxrhalservice_server)
binder_call(sxrhalservice_server, sxrhalservice_client)

# Add hwservice related rules
add_hwservice(sxrhalservice_server, sxrhalservice_hwservice)

#Allow access to firmware files for HDCP session
r_dir_file(sxrhalservice, vendor_firmware_file)
r_dir_file(sxrhalservice, firmware_file)

#Allow access to tee/ion device and tcp socket for HDCP sessions
allow sxrhalservice tee_device:chr_file rw_file_perms;
allow sxrhalservice ion_device:chr_file r_file_perms;
